{
  "name": "dsh-asset-library",
  "version": "0.6.1",
  "description": "Asset library for DeepSeek Harness: drop or paste images, crop objects locally or with a vision model, let the model name and classify the crops, browse them in a category tree, and let the agent search, read and export the material into Godot / Unity / web projects.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/longcheng4855-a11y/dsh-asset-library.git"
  },
  "homepage": "https://github.com/longcheng4855-a11y/dsh-asset-library#readme",
  "bugs": {
    "url": "https://github.com/longcheng4855-a11y/dsh-asset-library/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "asset-library",
    "sprite",
    "segmentation",
    "mcp",
    "godot",
    "unity"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "bin": {
    "dsh-asset-library-mcp": "./mcp-server.js"
  },
  "files": [
    "index.js",
    "client.js",
    "mcp-server.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/smoke-host.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
